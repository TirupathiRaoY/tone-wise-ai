# Session and OAuth settings. For local development use the localhost APP_URL.
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_HTTPS_ONLY=false
APP_PORT=8001
APP_URL=http://127.0.0.1:8001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Gmail SMTP: create a Google App Password and use it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM=your-gmail-address@gmail.com

# Local Ollama & AI Provider Settings
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
PROVIDER_ORDER=gemini,groq,openrouter,huggingface,ollama

# Comma-separated key pools; the single-key variables remain supported.
GEMINI_API_KEYS=
GROQ_API_KEYS=
